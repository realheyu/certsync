# 安装到 /etc/certsync/pull.env，root:root 0600；set -a 后加载。
CERTSYNC_KEY=''
# 组名与上传端子目录完全一致，支持普通域名和以 *. 开头的通配域名。
# * 是组名中的字面字符，不会匹配其他组；此处不是证书的 SAN 列表。
# 通配组要求证书 SAN 包含对应通配域名；普通组 example.com 继续兼容。
CERTSYNC_GROUPS='*.example.com,other.com'
# 输出总目录，每组安装到 <总目录>/<组名>/。
CERTSYNC_OUTPUT_DIR='/etc/nginx/certs'
# 仅下载权限；不配置 DNS 凭证。
OSS_ACCESS_KEY_ID=''
OSS_ACCESS_KEY_SECRET=''
OSS_REGION='cn-hangzhou'
OSS_ENDPOINT='https://oss-cn-hangzhou.aliyuncs.com'
OSS_BUCKET='my-cert-bucket'
OSS_PREFIX='certsync'

# 钉钉群自定义机器人（可选），留空时不发送群消息。
# 仅在证书和私钥确实替换成功后通知；内容未变或安装失败时不发成功通知。
# 通知表示文件安装成功，不代表外层 Nginx 检查或 reload 已成功。
DINGTALK_WEBHOOK=''
# 启用“加签”时填写 SEC...；关键词/IP 验证时可留空。
# 若机器人启用关键词验证，请配置 certsync。
DINGTALK_SECRET=''
