# 安装为 /etc/certsync/config.toml，root:root 0600。
# 上传端填写 [push]，业务机填写 [pull]，可以删掉不用的区块。
# 两端使用同一个 key（openssl rand -base64 32 生成），分别填写 OSS 凭证。

[push]
key = ""
source_dir = ""
oss_region = ""
# oss_endpoint = ""
oss_bucket = ""
oss_prefix = ""
oss_access_key_id = ""
oss_access_key_secret = ""
# 可选：证书临期或过期时通知。
dingtalk_webhook = ""
dingtalk_secret = ""

[pull]
key = ""
output_dir = ""
# 组名和上传目录名完全一致，* 是组名的一部分。
groups = []
oss_region = ""
# oss_endpoint = ""
oss_bucket = ""
oss_prefix = ""
oss_access_key_id = ""
oss_access_key_secret = ""
# 可选：证书文件替换成功后通知。
dingtalk_webhook = ""
dingtalk_secret = ""
