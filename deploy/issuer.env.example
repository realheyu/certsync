# 安装到 /etc/certsync/issuer.env，root:root 0600；set -a 后加载。
# 两端 CERTSYNC_KEY 相同；使用 openssl rand -base64 32 生成。
CERTSYNC_KEY=''
# 总目录下每个组名子目录放一组 fullchain.pem / privkey.pem。
# 普通组 example.com 和通配组 *.example.com 均支持；Shell 中含 * 的路径须加引号。
CERTSYNC_SOURCE_DIR='/var/lib/certsync/certs'
ACME_HOME='/opt/acme.sh'
ACME_EMAIL='ops@example.com'
ACME_SERVER='letsencrypt'
Ali_Key=''
Ali_Secret=''
# 使用专用 OSS 上传账号，不能与业务机共用凭证。
OSS_ACCESS_KEY_ID=''
OSS_ACCESS_KEY_SECRET=''
OSS_REGION='cn-hangzhou'
OSS_ENDPOINT='https://oss-cn-hangzhou.aliyuncs.com'
OSS_BUCKET='my-cert-bucket'
OSS_PREFIX='certsync'

# 钉钉群自定义机器人（可选），留空时只记录本地有效期告警。
# 每次 push 检查到剩余有效期严格少于 15 天就告警；已过期也告警但拒绝上传。
# 填完整 Webhook：https://oapi.dingtalk.com/robot/send?access_token=...
DINGTALK_WEBHOOK=''
# 机器人启用“加签”时填写 SEC...；只使用关键词/IP 验证时可留空。
# 所有通知均包含关键词 certsync；若启用关键词验证，请配置该关键词。
DINGTALK_SECRET=''
