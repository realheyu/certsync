# certsync 敏感环境变量(§11.3)→ 复制为 /etc/certsync/certsync.env(0600 root)
# 只放 config.toml 中标注了 env 回退的凭证;两类机器同变量名、不同 RAM 账号,勿拷贝混用!

# ── 签发机 ──
#ALICLOUD_ACCESS_KEY=       # alidns DNS-01(lego)
#ALICLOUD_SECRET_KEY=
#OSS_ACCESS_KEY_ID=         # OSS 上传 RAM 账号(仅 oss:PutObject)
#OSS_ACCESS_KEY_SECRET=
#DINGTALK_SECRET=           # 告警凭证按已配置的通道放,未配置的通道不放
#ALERT_MAIL_USER=
#ALERT_MAIL_PASS=

# ── 业务机 ──
#OSS_ACCESS_KEY_ID=         # OSS 拉取 RAM 账号(仅 oss:GetObject),与签发机不同账号!
#OSS_ACCESS_KEY_SECRET=
#DINGTALK_SECRET=
#ALERT_MAIL_USER=
#ALERT_MAIL_PASS=
