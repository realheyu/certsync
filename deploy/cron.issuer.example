# /etc/cron.d/certsync，root:root 0644。关闭 acme.sh 默认 cron 和旧 certsync renew 任务。
# 一次续期检查后，push 遍历总目录，逐组上传独立 JSON 加密包。
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

23 3 * * * root flock -n /run/certsync-issuer.lock timeout 1800 /usr/local/sbin/certsync-issuer-job >>/var/log/certsync.log 2>&1
